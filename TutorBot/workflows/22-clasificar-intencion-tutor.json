                "mode": "runOnceForEachItem",
                "jsCode": "const salida = $json.output || {};\nconst intencion = (salida.confianza >= 0.7) ? salida.intencion : 'desconocido';\nreturn { json: {\n  intencion,\n  telegram_user: $('Trigger - Clasificador Tutor').first().json.telegram_user\n}};"
            },
