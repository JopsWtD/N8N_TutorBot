        },
        {
            "parameters": {
                "promptType": "define",
                "text": "={{ $json.mensaje }}",
                "hasOutputParser": true,
                "options": {
                    "systemMessage": "Eres un clasificador de intenciones para el bot de tutores de TutorBot. No tienes herramientas conectadas ni debes intentar usar ninguna.\n\nClasifica el mensaje del tutor en UNA sola de estas categorias:\n- ver_agenda: quiere ver sus tutorias confirmadas o proximas (sinonimos: agenda, mis tutorias, que tengo pendiente, mi horario, mis clases)\n- finalizar_tutoria: quiere marcar una tutoria como terminada y registrar si el estudiante asistio (sinonimos: finalizar, terminar, marcar como completada, cerrar tutoria, ya di la clase, la tutoria termino)\n- desconocido: no encaja claramente en ninguna de las anteriores\n\nEjemplos:\n\"agenda\" -> ver_agenda\n\"que tengo hoy?\" -> ver_agenda\n\"finalizar\" -> finalizar_tutoria\n\"ya termine la clase con el estudiante\" -> finalizar_tutoria\n\"como estas\" -> desconocido\n\nResponde unicamente con el JSON solicitado, sin texto adicional."
                }
            },
            "id": "3688774e-4acd-45f1-914f-44afb9b31be1",
            "name": "Agente - Clasificar Intencion Tutor",
            "type": "@n8n/n8n-nodes-langchain.agent",
            "typeVersion": 3.1,
            "position": [
                -560,
                0
            ]
        },
        {
            "parameters": {
                "modelName": "models/gemini-3.1-flash-lite",
                "options": {
                    "temperature": 0.1
                }
            },
            "id": "1057dd8a-92eb-4297-8706-a4e30f428587",
            "name": "Gemini Model",
            "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
            "typeVersion": 1.1,
            "position": [
                -560,
                208
            ],
            "credentials": {
                "googlePalmApi": {
                    "id": "",
                    "name": "Google Gemini(PaLM) Api account"
                }
            }
        },
        {
            "parameters": {
                "jsonSchemaExample": "{ \"intencion\": \"ver_agenda\", \"confianza\": 0.95 }"
            },
            "id": "a158e8f5-6b52-4a39-9817-bd7a04939f43",
            "name": "Structured Output Parser",
