            "parameters": {
                "jsCode": "const filas = $input.all().map(i => i.json).filter(f => f.documento);\nconst calc = $('Code - Calcular Puntos').first().json;\nif (filas.length === 0) {\n  return [{ json: { ...calc, huboEstudiante: false } }];\n}\nconst estudiante = filas[0];\nconst puntosPrevios = Number(estudiante.puntos) || 0;\nconst puntosNuevos = puntosPrevios + calc.delta;\nreturn [{ json: {\n  ...calc,\n  huboEstudiante: true,\n  documento: estudiante.documento,\n  nombre: estudiante.nombre,\n  telegram_user_estudiante: estudiante.telegram_user,\n  puntos: puntosNuevos\n}}];"
