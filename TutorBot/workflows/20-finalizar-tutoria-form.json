                "jsCode": "const t = $json.tutoria;\nconst inicio = new Date(t.fecha + 'T' + t.hora);\nconst ahora = new Date();\nconst horasTranscurridas = (ahora - inicio) / (1000 * 60 * 60);\n\nlet puedeFinalizarse = true;\nlet motivo = '';\nif (horasTranscurridas < 0) {\n  puedeFinalizarse = false;\n  motivo = 'Esa tutoria todavia no empieza (' + t.fecha + ' ' + t.hora + '). No puedes finalizarla antes de que comience.';\n} else if (horasTranscurridas < 1) {\n  puedeFinalizarse = false;\n  motivo = 'Todavia no ha pasado 1 hora desde el inicio de la tutoria (' + t.fecha + ' ' + t.hora + '). Intenta de nuevo mas tarde.';\n}\n\nreturn { json: { ...$json, puedeFinalizarse, motivo } };"
