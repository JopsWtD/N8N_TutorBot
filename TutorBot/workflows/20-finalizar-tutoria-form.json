                "jsCode": "const seleccion = $json['Tutoria'] || '';\nconst match = seleccion.match(/\\(([^)]+)\\)$/);\nconst id_tutoria = match ? match[1] : null;\nconst tutorias = $('Sheets - Get Tutorias Tutor').all().map(i => i.json);\nconst tutoria = tutorias.find(t => t.id_tutoria === id_tutoria);\nreturn { json: {\n  telegram_user: $('Sheets - Get Tutor').first().json.telegram_user,\n  id_tutoria,\n  tutoria\n}};"
