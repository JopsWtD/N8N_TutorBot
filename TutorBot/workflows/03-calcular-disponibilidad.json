    {"parameters":{"jsCode":"const tutoresValidos = $('Code - cruce materia').all().map(i => i.json.id_tutor);\nconst dia = $('Code - dia semana').first().json.dia_semana;\nconst bloques = [];\nfor (const item of $input.all()) {\n  const d = item.json;\n  if (!tutoresValidos.includes(d.id_tutor) || d.dia_semana !== dia) continue;\n  let [h, m] = d.hora_inicio.split(':').map(Number);\n  const [hf] = d.hora_fin.split(':').map(Number);\n  while (h < hf) {\n    bloques.push({ id_tutor: d.id_tutor, hora: String(h).padStart(2,'0') + ':00' });\n    h += 1;\n  }\n}\nreturn bloques.map(b => ({ json: b }));","mode":"runOnceForAllItems"},"id":"091ab51e-ae49-45c8-b672-f70cde577dc9","name":"Code - genera bloques","type":"n8n-nodes-base.code","typeVersion":2,"position":[1136,-112],"alwaysOutputData":true},
