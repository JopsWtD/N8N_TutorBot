    {"parameters":{"mode":"runOnceForEachItem","jsCode":"const previo = $('Switch - Tipo').item.json;\nconst respuesta = $json;\nlet pasos = previo.pasos_restantes;\nif (respuesta.nuevos_pasos && respuesta.nuevos_pasos.length > 0) {\n  pasos = [...respuesta.nuevos_pasos, ...pasos];\n}\nreturn {\n  json: {\n    ...previo,\n    pasos_restantes: pasos,\n    valido: respuesta.valido === true,\n    valor: respuesta.valor !== undefined ? respuesta.valor : null\n  }\n};"},"id":"f6a0c61c-b303-45a0-92d1-8926b2288d9c","name":"Code - Fusionar Logic","type":"n8n-nodes-base.code","typeVersion":2,"position":[896,1376]},
