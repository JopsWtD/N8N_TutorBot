    {"parameters":{"mode":"runOnceForEachItem","jsCode":"const sesion = $json;\nconst pasos = typeof sesion.pasos_restantes === 'string'\n  ? JSON.parse(sesion.pasos_restantes || '[]')\n  : (sesion.pasos_restantes || []);\nconst datosParciales = typeof sesion.datos_parciales === 'string'\n  ? JSON.parse(sesion.datos_parciales || '{}')\n  : (sesion.datos_parciales || {});\n\nreturn {\n  json: {\n    ...sesion,\n    mensaje: $('Trigger - Procesador de Pasos').item.json.mensaje,\n    telegram_user: $('Trigger - Procesador de Pasos').item.json.telegram_user,\n    pasos_restantes: pasos,\n    datos_parciales: datosParciales,\n    paso_actual: pasos.length > 0 ? pasos[0] : null\n  }\n};"},"id":"dbdf3ecd-c6a3-4beb-bc78-57284f65ddf7","name":"Code - Preparar Sesion","type":"n8n-nodes-base.code","typeVersion":2,"position":[0,912]},
